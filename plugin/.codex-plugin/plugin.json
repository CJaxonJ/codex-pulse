{
  "name": "codex-pulse",
  "version": "0.9.18",
  "description": "Quota-aware guidance for ordinary Codex chats, backed by the user's local Codex Pulse monitor.",
  "author": {
    "name": "CJaxonJ",
    "url": "https://github.com/CJaxonJ"
  },
  "homepage": "https://github.com/CJaxonJ/codex-pulse",
  "repository": "https://github.com/CJaxonJ/codex-pulse",
  "license": "MIT",
  "requires_local_executor": true,
  "keywords": ["codex", "quota", "usage", "productivity"],
  "skills": "./skills/",
  "hooks": {
    "description": "Local quota guidance from Codex Pulse. Prompts are inspected in memory only and are never saved.",
    "hooks": {
      "SessionStart": [
        {
          "matcher": "startup|resume|compact",
          "hooks": [
            {
              "type": "command",
              "command": "/usr/bin/env node \"$PLUGIN_ROOT/scripts/pulse-hook.mjs\"",
              "timeout": 3,
              "statusMessage": "Checking Codex quota",
              "additionalContextLimit": 800
            }
          ]
        }
      ],
      "UserPromptSubmit": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "/usr/bin/env node \"$PLUGIN_ROOT/scripts/pulse-hook.mjs\"",
              "timeout": 3,
              "statusMessage": "Planning quota headroom",
              "additionalContextLimit": 800
            }
          ]
        }
      ],
      "PreToolUse": [
        {
          "matcher": "*",
          "hooks": [
            {
              "type": "command",
              "command": "/usr/bin/env node \"$PLUGIN_ROOT/scripts/pulse-hook.mjs\"",
              "timeout": 15
            }
          ]
        }
      ],
      "PostToolUse": [
        {
          "matcher": "*",
          "hooks": [
            {
              "type": "command",
              "command": "/usr/bin/env node \"$PLUGIN_ROOT/scripts/pulse-hook.mjs\"",
              "timeout": 15,
              "additionalContextLimit": 800
            }
          ]
        }
      ],
      "Stop": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "/usr/bin/env node \"$PLUGIN_ROOT/scripts/pulse-hook.mjs\"",
              "timeout": 15
            }
          ]
        }
      ],
      "Interrupt": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "/usr/bin/env node \"$PLUGIN_ROOT/scripts/pulse-hook.mjs\"",
              "timeout": 3
            }
          ]
        }
      ]
    }
  },
  "interface": {
    "displayName": "Codex Pulse",
    "shortDescription": "Quota alerts and safe recovery",
    "longDescription": "Local macOS quota alerts, saved continuation previews and safe recovery for Codex chats. Requires the separate Codex Pulse runtime and personally reviewed Hooks. Optional expiring-credit redemption is off by default and requires explicit personal-account consent. Never uploads prompts or auto-approves permissions. This local Hook plugin is not the public-directory skills package.",
    "developerName": "CJaxonJ",
    "category": "Developer Tools",
    "capabilities": ["Read", "Write"],
    "brandColor": "#2E8477",
    "brandColorDark": "#67B7A8",
    "logo": "./assets/logo.svg",
    "logoDark": "./assets/logo-dark.svg",
    "composerIcon": "./assets/composer-icon.svg",
    "composerIconDark": "./assets/composer-icon-dark.svg",
    "defaultPrompt": [
      "Show my current Codex Pulse recommendation.",
      "Help me decide whether to start a large Codex task now."
    ]
  },
  "extensions": {
    "com.openai": {
      "onboardingSkill": "./skills/setup/SKILL.md"
    }
  }
}
